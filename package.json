{
  "name": "nextfour-backend",
  "version": "0.1.0",
  "private": true,
  "description": "NextFour backend \u2014 Node/TypeScript Express API on Render, backed by Supabase Postgres.",
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.11.0 <21"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "node scripts/migrate.mjs",
    "migrate:status": "node scripts/migrate.mjs --status",
    "smoke": "node scripts/smoke.mjs",
    "seed:dev": "node scripts/seed-dev.mjs",
    "verify:rls": "node --experimental-websocket scripts/verify-rls.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/node": "^20.19.9",
    "@types/pg": "^8.15.5",
    "pg": "^8.16.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
