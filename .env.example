# Copy to .env and fill in. NEVER commit .env or paste real key values into this file.

# --- Runtime (also set these in the Render dashboard) ---

# Supabase project URL. Project ref: zkxvalydqymacenulcdj
SUPABASE_URL=https://zkxvalydqymacenulcdj.supabase.co

# NEW-FORMAT "secret" key (sb_secret_...), NOT the legacy service_role JWT.
# Dashboard: Project Settings > API Keys > Secret keys.
# This key BYPASSES Row Level Security. Backend only — it must never reach the app repo.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Port for the local HTTP server. Render injects its own PORT; leave it unset there.
PORT=3000

# NEW-FORMAT "publishable" key (sb_publishable_...). Safe for clients; subject to RLS.
# Used here ONLY by `npm run verify:rls` — the secret key would bypass RLS and false-pass.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Dev-only password you choose for the seeded dev organizer auth user
# (dev.organizer@example.com). Used by npm run seed:dev and npm run import:dev.
DEV_ORGANIZER_PASSWORD=choose_a_local_dev_password

# --- Migrations only (NOT needed in Render) ---

# Postgres connection string used by `npm run migrate`.
# Dashboard: Connect > Session pooler (port 5432). Transaction pooler (6543) also works.
# Contains the database password, so it stays local.
SUPABASE_DB_URL=postgresql://postgres.zkxvalydqymacenulcdj:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
